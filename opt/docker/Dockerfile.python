# Dockerfile for building the Python Lambda extension image
#
# This image contains the extension files at /opt and can be used in
# multi-stage builds for containerized Lambda functions:
#
#   FROM public.ecr.aws/lambda/python:3.12
#   COPY --from=public.ecr.aws/dash0/extension-python:latest /opt /opt
#   ENV AWS_LAMBDA_EXEC_WRAPPER=/opt/wrapper
#   ...
#
# Build with:
#   make docker-python
#
# Or manually:
#   # First build the binaries and stage the layer
#   make build/$(ZIP_NAME_PYTHON)
#   # Then write the git hash and build the Docker image
#   git rev-parse HEAD > build/dash0_git_hash
#   docker build -f opt/docker/Dockerfile.python -t dash0/extension-python:latest .

# Stage 1: Build Python dependencies
FROM public.ecr.aws/lambda/python:3.12 AS python-deps

WORKDIR /var/task

# Install git (required by setuptools_scm during package installation)
RUN dnf install -y git && dnf clean all

COPY opt/python/distro/requirements.txt .

# Install dependencies into a directory Lambda will recognize
RUN python3.12 -m pip install --upgrade --no-cache-dir pip \
    && python3.12 -m pip install --no-cache-dir -r requirements.txt -t /asset-output/python

COPY opt/python/distro/src/dash0_opentelemetry /asset-output/python/dash0_opentelemetry
COPY opt/python/distro/requirements.txt /asset-output/python/dash0_opentelemetry/requirements.txt

# Stage 2: Final image with extension
FROM scratch

# Copy extension binaries (both architectures - entrypoint selects at runtime)
COPY build/dash0_x86_64 /opt/dash0_x86_64
COPY build/dash0_aarch64 /opt/dash0_aarch64

# Copy entrypoint script (Lambda extension entry point)
COPY opt/entrypoint /opt/extensions/dash0

# Copy shared script and wrapper script
COPY opt/shared.sh /opt/shared.sh
# Bake in the git hash so the extension reports faas.extension.git_hash (read by opt/shared.sh)
COPY build/dash0_git_hash /opt/dash0_git_hash
COPY opt/python/wrapper /opt/wrapper

# Copy Python SDK and dependencies
COPY --from=python-deps /asset-output/python /opt/python

# Copy OpenTelemetry wrapper
COPY opt/python/otel_wrapper.py /opt/python/otel_wrapper.py
