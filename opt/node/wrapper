#!/bin/bash
args=("$@")

if [ "$X_LUMIGO_KILLSWITCH" = "true" ]; then
    exec "${args[@]}"
fi

# Copy DASH0_* masking env vars to LUMIGO_* equivalents
[ -n "$DASH0_MASK_RULES" ] && export LUMIGO_SECRET_MASKING_REGEX="$DASH0_MASK_RULES"
[ -n "$DASH0_MASK_REQUEST_BODY" ] && export LUMIGO_SECRET_MASKING_REGEX_HTTP_REQUEST_BODIES="$DASH0_MASK_REQUEST_BODY"
[ -n "$DASH0_MASK_REQUEST_HEADERS" ] && export LUMIGO_SECRET_MASKING_REGEX_HTTP_REQUEST_HEADERS="$DASH0_MASK_REQUEST_HEADERS"
[ -n "$DASH0_MASK_RESPONSE_BODY" ] && export LUMIGO_SECRET_MASKING_REGEX_HTTP_RESPONSE_BODIES="$DASH0_MASK_RESPONSE_BODY"
[ -n "$DASH0_MASK_RESPONSE_HEADERS" ] && export LUMIGO_SECRET_MASKING_REGEX_HTTP_RESPONSE_HEADERS="$DASH0_MASK_RESPONSE_HEADERS"
[ -n "$DASH0_MASK_QUERY_PARAMS" ] && export LUMIGO_SECRET_MASKING_REGEX_HTTP_QUERY_PARAMS="$DASH0_MASK_QUERY_PARAMS"

export AWS_LAMBDA_RUNTIME_API="127.0.0.1:9009"
export LUMIGO_ENDPOINT="http://127.0.0.1:9009/v1/traces"
export LUMIGO_LOGS_ENDPOINT="http://127.0.0.1:9009/v1/logs"
export LUMIGO_TRACER_TOKEN="t_xxxx"

export LAMBDA_RESOURCE_ATTRIBUTES="cloud.region=$AWS_REGION,cloud.provider=aws,faas.name=$AWS_LAMBDA_FUNCTION_NAME,faas.version=$AWS_LAMBDA_FUNCTION_VERSION,faas.instance=$AWS_LAMBDA_LOG_STREAM_NAME";

if [ -z "${OTEL_RESOURCE_ATTRIBUTES}" ]; then
    export OTEL_RESOURCE_ATTRIBUTES=$LAMBDA_RESOURCE_ATTRIBUTES;
else
    export OTEL_RESOURCE_ATTRIBUTES="$LAMBDA_RESOURCE_ATTRIBUTES,$OTEL_RESOURCE_ATTRIBUTES";
fi

if [ -z "${OTEL_SERVICE_NAME}" ]; then
    export OTEL_SERVICE_NAME=$AWS_LAMBDA_FUNCTION_NAME;
fi

# Write env vars to a file for the extension to read
echo "{\"OTEL_SERVICE_NAME\": \"$OTEL_SERVICE_NAME\", \"OTEL_RESOURCE_ATTRIBUTES\": \"$OTEL_RESOURCE_ATTRIBUTES\"}" > /tmp/lumigo_env_vars || true


# enable auto instrumentation unless DISABLE_AUTO_INSTRUMENTATION is set
if [ -z "$DISABLE_AUTO_INSTRUMENTATION" ] || [ "${DISABLE_AUTO_INSTRUMENTATION,,}" = "false" ]; then

  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  TIMING_LOADER="/opt/timing-loader.mjs"
  PACKAGE_PATH="/opt/init.mjs"
  export NODE_OPTIONS="${NODE_OPTIONS} --import \"${PACKAGE_PATH}\""
fi

echo "starting execution of user handler"

exec "${args[@]}"
